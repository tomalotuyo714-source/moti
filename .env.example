# Copie este archivo como .env y ponga sus valores reales.
# NUNCA suba el archivo .env a GitHub (ya esta en .gitignore).
#
# Los saca de: supabase.com -> su proyecto -> Project Settings -> API
# La "anon key" es publica por diseno: puede ir en el frontend.
# La "service_role key" NO se usa aqui y no debe ponerse nunca en el frontend.

VITE_SUPABASE_URL=https://SU_PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=SU_ANON_KEY
